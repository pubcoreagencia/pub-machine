{
  "name": "@pubcore/pub-machine",
  "version": "0.1.0",
  "description": "PUB Machine — Motor de inteligência operacional, prospecção e geração de negócios da PUB Core Holding",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test:signal": "tsx tests/signal-capture.test.ts",
    "test:audience": "tsx tests/audience-intelligence.test.ts",
    "test:integration": "ts-node --transpile-only tests/physical-intent-integration.test.ts",
    "test:decision": "ts-node --transpile-only tests/decision-dispatch.test.ts",
    "test": "tsx tests/signal-capture.test.ts && tsx tests/audience-intelligence.test.ts && ts-node --transpile-only tests/physical-intent-integration.test.ts && ts-node --transpile-only tests/decision-dispatch.test.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pubcoreagencia/pub-machine.git"
  },
  "keywords": [
    "pub-machine",
    "pub-core",
    "signal-intelligence",
    "presence-intelligence",
    "audience-intelligence",
    "physical-intent",
    "geofence",
    "closed-loop"
  ],
  "author": "PUB Core Holding",
  "license": "UNLICENSED",
  "devDependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/event-emitter": "^12.0.1",
    "@types/node": "^22.20.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^5.8.2"
  }
}
